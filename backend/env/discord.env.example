# The platform's only bot token: every other service reaches Discord through this
# bot over RabbitMQ. (identity-service's OAuth app is DISCORD_CLIENT_ID/SECRET in auth.env.)
DISCORD_TOKEN=your_discord_bot_token

PROXY_IP=your_proxy_ip
PROXY_PORT=your_proxy_port
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password
