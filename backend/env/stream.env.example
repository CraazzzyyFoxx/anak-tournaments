# stream-svc (headless FastStream) — tournament stream live-status.
#
# Most settings come from common.env (POSTGRES_*, REDIS_URL, RABBITMQ_URL).
# This file carries only stream-svc-specific overrides.
#
# NOTE: whether polling runs at all, how often, and the Helix batch size are NOT
# env vars — they live in the admin `Settings` table under the `stream.collection`
# key so they can be changed without a redeploy. It defaults to `enabled=false`,
# so setting the credentials below does not by itself start any polling.

# Prometheus worker metrics port (optional; unset = metrics server disabled).
# WORKER_METRICS_PORT=9111

# Twitch Helix credentials for the live-status poller. This is an APP access
# token (client_credentials) — the poller asks "who is live" about channels it
# does not own, which needs no user consent.
# TWITCH_CLIENT_ID is the SAME app id identity-service uses for Twitch OAuth
# (and tournament-service for subscription checks), so the 800-points/min app
# bucket is shared: if identity starts seeing 429s, raise `interval_seconds`.
# TWITCH_CLIENT_SECRET is that app's secret — identity-service already has it.
# Leaving either unset does NOT fail loudly: the Helix client reports
# `HelixNotConfigured`, the poll tick no-ops, and no tournament shows live streams.
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
