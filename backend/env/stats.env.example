PORT=8002
PROXY_IP=your_proxy_ip
PROXY_PORT=your_proxy_port
PROXY_USERNAME=your_proxy_username
PROXY_PASSWORD=your_proxy_password

# Twitch subscription verification for the scheduled collector and the admin
# re-check trigger. Same value as auth.env. Unset means every live Twitch check
# resolves `unknown` (`twitch_client_not_configured`), which fails open — the
# sweep runs and proves nothing. Boosty (Discord roles) is asked of discord-service
# over RabbitMQ; this service holds no Discord bot token.
TWITCH_CLIENT_ID=your_twitch_client_id

# Disciplines this deployment serves: comma-separated installed discipline codes (e.g. overwatch,lol). The worker
# consumes one stats.ingest.<code> queue per entry and runs those disciplines' jobs. Omit it to serve every installed
# discipline. An empty value, a duplicate or an unknown code stops both processes at startup; there is no fallback.
# STATS_DISCIPLINES=overwatch
