[importlinter]
# Enforces the service layering described in backend/ARCHITECTURE.md.
#
# Layer shape per domain:
#   src/rpc/<x>.py              transport: decode, gate, one service call. No SQL.
#   services/<d>/service.py     class <D>Service + singleton — orchestration, cache, mapping
#   services/<d>/queries[.py|/] class <D>Queries + singleton — analytical SQL only
#   services/<d>/_mappers.py    sync ORM -> DTO functions
#   shared.repository           CRUD, flush-only

root_packages =
    src

# ----------------------------------------------------------------------------
# Contract 1: identity and tenancy stay independent inside src.services.
# ----------------------------------------------------------------------------
[importlinter:contract:services-independence]
name = src.services user and workspace stay independent
type = independence
modules =
    src.services.user
    src.services.workspace


# ----------------------------------------------------------------------------
# Contract 2: the transport layer owns no data access.
#
# rpc/*.py decodes parameters, gates permissions and calls one service. It must
# never reach a query class directly.
# ----------------------------------------------------------------------------
[importlinter:contract:rpc-goes-through-services]
name = RPC transport must orchestrate via services, never query classes
type = forbidden
allow_indirect_imports = True
source_modules =
    src.rpc
forbidden_modules =
    src.services.user.queries
