# ==============================================================================
# owt-backup — конфигурация контура резервных копий (rustfs source + replica).
#
# Копия этого файла живёт как ops/backup/backup.env на КАЖДОМ из двух хостов
# (dd-new и home) и НЕ коммитится. Один файл на оба хоста — все скрипты и оба
# compose-файла читают его.
#
#   cp ops/backup/backup.env.example ops/backup/backup.env && chmod 600 ops/backup/backup.env
#
# Пароли: openssl rand -base64 30
# ==============================================================================

# ------------------------------------------------------------------------------
# Общее
# ------------------------------------------------------------------------------
# `latest` у rustfs протухший (обновлён 2026-07-30, до релиза 1.0.0-rc.1) —
# тег всегда пинуем явно.
RUSTFS_IMAGE=rustfs/rustfs:1.0.0-rc.1

# Бакет с бэкапами. Одно имя на обоих хостах (репликация 1:1 по ключам).
BACKUP_BUCKET=owt-backups

# ------------------------------------------------------------------------------
# rustfs на dd-new (источник)
# ------------------------------------------------------------------------------
# Каталоги на ХОСТЕ. Контейнер работает под uid:gid 10001 — setup.sh делает chown.
RUSTFS_DATA_DIR=/srv/owt-backup/rustfs/data
RUSTFS_LOG_DIR=/srv/owt-backup/rustfs/logs

# root-креды локального rustfs. Порты слушают только 127.0.0.1, но root-ключ
# всё равно даёт полный доступ к admin API — генерируем, а не придумываем.
RUSTFS_ROOT_USER=owt-root
RUSTFS_ROOT_PASSWORD=
# Куда стучится джоба на самом хосте. Менять, только если сменили порт/биндинг
# в docker-compose.backup.yml.
LOCAL_S3_URL=http://127.0.0.1:9000

# ------------------------------------------------------------------------------
# rustfs на home (реплика)
# ------------------------------------------------------------------------------
# Домен, на который смотрит A-запись домашнего IP. Caddy на home выпустит
# сертификат для него через ACME, поэтому 80/443 должны быть проброшены.
HOME_S3_DOMAIN=s3.example.com
# Куда ходят dd-new и оператор. Только https.
HOME_S3_URL=https://s3.example.com
# Email для ACME-аккаунта Let's Encrypt.
ACME_EMAIL=you@example.com

HOME_RUSTFS_DATA_DIR=/srv/owt-backup/rustfs/data
HOME_RUSTFS_LOG_DIR=/srv/owt-backup/rustfs/logs
HOME_CADDY_DATA_DIR=/srv/owt-backup/caddy

HOME_RUSTFS_ROOT_USER=owt-root
HOME_RUSTFS_ROOT_PASSWORD=

# Ключ, которым rustfs на dd-new пишет в реплику. Отдельный пользователь с
# политикой без DeleteObject: скомпрометированный dd-new не может вычистить
# реплику (setup.sh создаёт и пользователя, и политику).
REPL_ACCESS_KEY=owt-repl
REPL_SECRET_KEY=

# ------------------------------------------------------------------------------
# Джоба бэкапа (только dd-new)
# ------------------------------------------------------------------------------
# Контейнер Postgres, из которого снимаем дамп: pg_dump берётся ИЗ НЕГО, поэтому
# версия клиента гарантированно совпадает с сервером, а пароль не покидает
# контейнер (скрипт читает $POSTGRES_USER/$POSTGRES_PASSWORD внутри).
PG_CONTAINER=db_postgres
# Через пробел, если баз несколько (значения с пробелами — обязательно в
# кавычках: файл читается через `source`).
PG_DATABASES="anak_dev"

# Что ещё утаскиваем: файлы/каталоги хоста в один AES-шифрованный tar.
# Пути, которых нет, молча пропускаются.
BACKUP_CONFIG_PATHS="/etc/traefik /root/overwatch-tournaments/acme.json /root/overwatch-tournaments/backend/env"

# Контейнер RabbitMQ: rabbitmqctl export_definitions (топология обменников,
# очередей, пользователей). Пусто — шаг пропускается.
RABBITMQ_CONTAINER=owt-rabbitmq-1

# Парольная фраза для шифрования tar с секретами (env-файлы, acme.json,
# rabbitmq-defs). ЕДИНСТВЕННАЯ копия должна лежать в менеджере паролей вне обоих
# хостов: потерян файл — потерян доступ к содержимому tar.
SECRETS_PASSPHRASE_FILE=/etc/owt-backup/secrets.pass

# Рабочий каталог для дампа до выгрузки. Нужно свободного места >= размер дампа.
BACKUP_TMP_DIR=/var/tmp/owt-backup

# Сколько ждать появления объекта в реплике, прежде чем считать прогон
# неуспешным. Репликация асинхронная: 200 на PutObject не доказывает, что копия
# доехала до home.
REPL_WAIT_SECONDS=900

# Retention (ILM, выставляется setup.sh на обоих бакетах).
KEEP_DAYS=30
KEEP_NONCURRENT_DAYS=90

# Куда писать .prom-метрики для node-exporter (textfile collector).
TEXTFILE_DIR=/var/lib/node_exporter/textfile
