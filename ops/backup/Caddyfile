# S3 API реплики. Host-заголовок Caddy проксирует как пришёл — это обязательно:
# подпись SigV4 покрывает Host, а rustfs проверяет её по полученному значению.
# Консоль (:9001) наружу не выносим: она не нужна ни репликации, ни mc.
{$HOME_S3_DOMAIN} {
	reverse_proxy rustfs:9000
}
