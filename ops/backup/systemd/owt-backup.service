[Unit]
Description=owt: дамп Postgres + выгрузка в rustfs с проверкой реплики
Documentation=file:///root/overwatch-tournaments/docs/backup-rustfs.md
# Docker обязателен: и pg_dump, и mc запускаются в контейнерах.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# ExecStart правится под фактический путь чекаута репозитория.
ExecStart=/root/overwatch-tournaments/ops/backup/backup.sh
# Прогон ждёт подтверждения из реплики (REPL_WAIT_SECONDS, по умолчанию 900s)
# плюс сам дамп. Потолок с запасом, но не бесконечность: подвисший прогон должен
# умереть до следующего запуска таймера, иначе Type=oneshot их сериализует.
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
