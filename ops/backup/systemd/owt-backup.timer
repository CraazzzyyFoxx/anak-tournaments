[Unit]
Description=owt: ежедневный бэкап в 03:17 UTC

[Timer]
OnCalendar=*-*-* 03:17:00 UTC
# Хост мог быть выключен/перезагружен в момент срабатывания — догоняем при
# старте, иначе сутки останутся без бэкапа молча.
Persistent=true
RandomizedDelaySec=10m
Unit=owt-backup.service

[Install]
WantedBy=timers.target
